# ==============================
# Supabase Configuration
# ==============================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================
# Cloudinary Configuration (Video & Media Storage)
# ==============================
# Nama Cloud Cloudinary Anda (dapat dilihat di Dashboard Console Cloudinary)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Unsigned Upload Preset (buat di Settings > Upload > Upload presets > Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ==============================
# Xendit Payment Gateway (Sandbox Mode)
# ==============================
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
VITE_XENDIT_PUBLIC_KEY=xnd_public_development_your_public_key_here
